{
    "name": "xpenser",
    "version": "0.1.0",
    "description": "Open-source personal finance tracking app built with Cleverbrush Framework.",
    "private": true,
    "license": "MIT",
    "type": "module",
    "homepage": "https://xpenser.cleverbrush.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cleverbrush/xpenser.git"
    },
    "bugs": {
        "url": "https://github.com/cleverbrush/xpenser/issues"
    },
    "keywords": [
        "personal-finance",
        "expense-tracker",
        "self-hosted",
        "typescript",
        "nextjs",
        "cleverbrush",
        "mcp",
        "openapi"
    ],
    "packageManager": "npm@11.12.1",
    "overrides": {
        "next": "16.3.0-preview.6"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev --parallel",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "build": "turbo run build",
        "test": "vitest --run",
        "test:coverage": "vitest --run --coverage",
        "test:e2e": "playwright test",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.9",
        "@playwright/test": "^1.60.0",
        "@testing-library/react": "16.3.2",
        "@types/node": "22.15.3",
        "@types/react": "19.0.12",
        "@types/react-dom": "19.0.4",
        "@vitest/coverage-v8": "4.1.2",
        "jsdom": "29.0.1",
        "next": "16.3.0-preview.6",
        "tsup": "8.5.1",
        "turbo": "2.8.21",
        "typescript": "7.0.2",
        "vitest": "4.1.2"
    }
}
