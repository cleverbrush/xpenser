{
    "name": "@xpenser/timezone",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup && tsc --noEmit -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "clean": "rm -rf dist tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@js-temporal/polyfill": "^0.5.1"
    },
    "devDependencies": {
        "tsup": "8.5.1",
        "typescript": "6.0.3"
    }
}
