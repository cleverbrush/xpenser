{
    "name": "@xpenser/contracts",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./api": {
            "types": "./dist/api.d.ts",
            "import": "./dist/api.js"
        },
        "./hosted-auth": {
            "types": "./dist/hosted-auth.d.ts",
            "import": "./dist/hosted-auth.js"
        },
        "./schemas": {
            "types": "./dist/schemas.d.ts",
            "import": "./dist/schemas.js"
        },
        "./session": {
            "types": "./dist/session.d.ts",
            "import": "./dist/session.js"
        }
    },
    "scripts": {
        "build": "tsup && tsc --noEmit -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "clean": "rm -rf dist tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@cleverbrush/schema": "^4.3.1",
        "@cleverbrush/server": "^4.3.1"
    },
    "devDependencies": {
        "tsup": "8.5.1",
        "typescript": "6.0.3"
    }
}
