# ── Database ──────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xpenser_db
DB_USER=xpenser_user
DB_PASSWORD=xpenser_secret

# ── JWT ───────────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=3600

# ── Google OAuth ───────────────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ── Server ────────────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
WEB_PORT=3000

# ── Application ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── OpenTelemetry ──────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=xpenser-api

# ── Frankfurter API ────────────────────────────────────────────────────────────────
FRANKFURTER_API_URL=https://api.frankfurter.dev

# ── Web ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
